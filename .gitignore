# Byte-compiled
__pycache__/
*.py[cod]

# Caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/

# Engine output -- regenerated on every run, noisy in diffs.
# submissions/, best/, log/ and best-known.json are tracked on purpose:
# a winning plan you cannot recompute is the one thing worth version control.
traces/*
!traces/.gitkeep

# Transient
*.lock
*.tmp

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
